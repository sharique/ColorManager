<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ColorManager.MainWindow"
        Title="Color Manager"
        Width="600"
        Height="700">
    <StackPanel Margin="20" Spacing="10">
        <!-- Title -->
        <TextBlock Text="Color Manager" FontSize="32" FontWeight="Bold" TextAlignment="Center" />

        <!-- Palette Management -->
        <Border BorderThickness="1" BorderBrush="LightGray" Padding="10" Margin="0,10">
            <StackPanel Spacing="10">
                <TextBlock Text="Palette Management" FontSize="18" FontWeight="Bold" />
                
                <!-- Palette Selector -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Select Palette:" />
                    <ComboBox ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" />
                </StackPanel>

                <!-- Create New Palette -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Create New Palette:" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding NewPaletteName}" Width="300" Watermark="Palette name..." />
                        <Button Command="{Binding CreatePaletteCommand}" Content="Create" />
                    </StackPanel>
                </StackPanel>

                <!-- Delete Palette -->
                <Button Command="{Binding DeletePaletteCommand}" Content="Delete Selected Palette" Foreground="White" Background="#FF6B6B" />
            </StackPanel>
        </Border>

        <!-- Colors -->
        <TextBlock Text="Colors" FontSize="18" FontWeight="Bold" Margin="0,10" />
        <ItemsControl ItemsSource="{Binding Colors}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="5" Padding="20" Width="100" Height="100" Content="{Binding Hex}" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding Hex, StringFormat='#{0}'}" />
                        </Button.Background>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
